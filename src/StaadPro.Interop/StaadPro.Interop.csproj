<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net8.0-windows</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1589;CS1590</WarningsAsErrors>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <Authors>Srinivasa Rao Masanam</Authors>
    <Copyright>Copyright (c) 2026 StaadDev</Copyright>
    <PackageReleaseNotes>Windows preview for .NET Framework 4.8.1 and Windows .NET 8. Adds the independent PreferExistingOpenStaadWrapperProvider with verified process identity, retained roots, explicit blank/content checks, discovery policies, immutable acquisition diagnostics, cancellation between native calls and atomic non-overwriting target creation. Retains the existing provider and wrapper source unchanged. Includes expanded IntelliSense and managed tests on both targets plus controlled STAAD.Pro 2026 attachment/startup verification. Unmapped blanks, synchronous COM hangs and broader vendor/version validation remain documented limitations. Full release notes: https://github.com/structuraldeveloper/StaadPro.Interop/blob/main/docs/Release-Notes.md</PackageReleaseNotes>
    <Description>A strongly-typed Windows .NET wrapper for Bentley STAAD.Pro OpenSTAAD geometry, loads and verified model acquisition.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>staad;openstaad;geometry;loads;structural-engineering;bim;bentley;interop</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/structuraldeveloper/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/structuraldeveloper/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Compile Remove="Helpers\RotHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\NuGet-README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\Load-Queries.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Geometry-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Load-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Root-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Installation.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Publishing.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Release-Notes.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Prefer-Existing-Provider.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <!-- Opt-in metadata for the disposable modern-.NET test package; ordinary packaging is unchanged. -->
  <Import Project="..\..\eng\CoreTesting.Package.props" Condition="'$(BuildCoreTestingPackage)' == 'true'" />

</Project>
