<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1589;CS1590</WarningsAsErrors>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <ReleaseDocumentationVersion>1.0.0-preview.20261028.3</ReleaseDocumentationVersion>
    <PackageVersion>$(ReleaseDocumentationVersion)</PackageVersion>
    <Authors>Srinivasa Rao Masanam</Authors>
    <Copyright>Copyright (c) 2026 TensorStruct</Copyright>
    <PackageReleaseNotes>Completed all 29 main-project Table overloads with color conversions, typed alignment and table-wide font sizing. Added the first View function, ShowFront. Included comprehensive XML documentation, managed regression coverage and updated usage/coverage reports. Retained compact Markdown branding and independence/trademark notices. Publisher: TensorStruct. Full release notes: https://github.com/structuraldeveloper/StaadPro.Interop/blob/main/docs/Release-Notes.md</PackageReleaseNotes>
    <Description>A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>staad;openstaad;geometry;loads;structural-engineering;bim;bentley;interop</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/structuraldeveloper/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/structuraldeveloper/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>images/symbol-only-logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Documentation\ApiMembers.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
