<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <Authors>structs-dev</Authors>
    <Description>A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD geometry and load operations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>staad;openstaad;geometry;loads;structural-engineering;bim;bentley;interop</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/structuraldeveloper/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/structuraldeveloper/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\NuGet-README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\Load-Queries.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
