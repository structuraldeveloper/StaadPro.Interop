<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1589;CS1590</WarningsAsErrors>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <Authors>Srinivasa Rao Masanam</Authors>
    <Copyright>Copyright (c) 2026 StaadDev</Copyright>
    <PackageReleaseNotes>Preview release for Windows and .NET Framework 4.8.1. Adds the four-parameter AddAxialThermalGradientTo overload, AddMemberLoadsFromGroupsByLoadCase and AddNodalLoadsFromGroupsByLoadCase with matching public signatures and detailed XML IntelliSense. Keeps per-entity thermal COM calls on the caller's thread; nThreads is validated for compatibility and does not schedule workers. Preserves grouped delegation to existing assignment helpers, raw values and native mapping, with documented skip/null behavior, legacy activation-status handling and partial failures. Includes documentation for 140 geometry and 60 load overloads and verifies 69 packaged XML examples. Retains 21 load queries including GetLoadCases inclusive ID ranges and the earlier geometry, factored-load and model-attachment additions. Live mutation, engineering-unit and STAAD-version validation remain pending before stable release. Full release notes: https://github.com/structuraldeveloper/StaadPro.Interop/blob/main/docs/Release-Notes.md</PackageReleaseNotes>
    <Description>A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD geometry and load operations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>staad;openstaad;geometry;loads;structural-engineering;bim;bentley;interop</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/structuraldeveloper/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/structuraldeveloper/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\NuGet-README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\Load-Queries.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Geometry-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Load-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Installation.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Publishing.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Release-Notes.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
