<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1589;CS1590</WarningsAsErrors>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <Authors>Srinivasa Rao Masanam</Authors>
    <Copyright>Copyright (c) 2026 StaadDev</Copyright>
    <PackageReleaseNotes>Added OpenSTAADFile and ShowApplication with matching main-project signatures and expanded IntelliSense. Open validates and resolves the requested path before one native model-switch request; show dispatches once without opening a model. Both return the original root after native dispatch and propagate exceptions, without readiness/visibility verification, automatic saves, retries or rollback. Root coverage is 14 of 23 methods. Retains GetLoadCases and existing geometry/load APIs. Validated offline tests and installed-package examples; live native mutation/version validation remains pending. Full release notes: https://github.com/structuraldeveloper/StaadPro.Interop/blob/main/docs/Release-Notes.md</PackageReleaseNotes>
    <Description>A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD geometry and load operations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>staad;openstaad;geometry;loads;structural-engineering;bim;bentley;interop</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/structuraldeveloper/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/structuraldeveloper/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Documentation\ApiMembers.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\NuGet-README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\Load-Queries.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Geometry-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Load-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Root-Porting.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Installation.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Publishing.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\Release-Notes.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
